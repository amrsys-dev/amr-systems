    "contrast_requirements": {
      "normal_text": "WCAG 2.2 AA: >= 4.5:1 for text_primary and text_secondary on bg, surface and surface_elevated.",
      "primary_button_label": "WCAG 2.2 AA: >= 4.5:1 for action_primary_text on action_primary.",
      "secondary_button_label": "Use text_primary or text_secondary on action_secondary; each pairing >= 4.5:1.",
      "status_text": "success, warning and danger are semantic foreground colours; each must achieve >= 4.5:1 on bg, surface and surface_elevated.",
      "focus_indicator": "focus must achieve >= 3:1 against bg, surface and surface_elevated.",
      "decorative_tokens": "border and border_accent_edge are decorative separators and must not be the sole visual indicator of an interactive state."
    },
    "implementation_note": "Use text_primary/text_secondary for copy. Use success/warning/danger as foreground labels/icons, not as filled status backgrounds unless a separately tested on-colour token is added. accent and border_accent_edge are decorative and must not be used for body text."
  },
