    "geometry": "Outer card radius 16px; nested element radius 12px; status badge radius 999px.",
    "numerals": "font-variant-numeric: tabular-nums for every number, currency, date, quantity and measurement.",
    "hero_anatomy": "Left context/status; right compact AMR ID trigger; primary module anchor card immediately below.",
    "tactile_feedback": "Pressed scale 0.98 over 120ms; no spring/bounce easing.",
