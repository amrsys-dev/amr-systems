{
  "version": "1.2",
  "status": "approved_design_system_contract_final",
  "brand": {
    "monogram_geometry": "immutable_user_supplied_connected_a_m_R_silhouette",
    "geometry_description": "Use the exact connected lowercase-styled a-m-R contour shown in the supplied AMR brand identity references. The circular a counter, two central vertical arches, R bowl/terminal and pointed lower R-leg cut are all fixed.",
    "allowed_monogram_variations": [
      "colour",
      "material_finish",
      "lighting",
      "background"
    ],
    "prohibited_monogram_changes": [
      "redraw",
      "retype",
      "stretch",
      "skew",
      "crop",
      "reshape",
      "simplify",
      "add_frame"
    ],
    "watermark": {
      "opacity_min": 0.03,
      "opacity_max": 0.05,
      "allowed_placements": [
        "primary_hero_cards",
        "splash_screens",
        "AMR_ID_header"
      ],
      "must_not_reduce_content_contrast": true
    },
    "approved_monogram_treatments": {
      "dark_background": [
        "champagne_gold",
        "emerald",
        "white",
        "silver"
      ],
      "light_background": [
        "deep_emerald",
        "graphite",
        "champagne_gold",
        "black"
      ],
      "flat_variants_for": [
        "small_digital_ui",
        "favicon",
        "compact_placements"
      ],
      "metallic_variants_for": [
        "large_brand_placements",
        "launch_screens",
        "presentation_covers",
        "promotional_materials"
      ],
      "production_source_rule": "Use supplied original vector master only; the HTML prototype uses a clearly labelled typographic placeholder, not production artwork."
    },
    "logo_and_monogram_identity": "The supplied AMR monogram is both the logo and the brand's meaningful letterform identity; it is not a replaceable decorative mark.",
    "approved_reference_images": [
      "brand-reference/AMR_Monogram_Usage_Guide_Reference.png",
      "brand-reference/AMR_Monogram_Metallic_Master_Reference.png"
    ],
    "geometry_authority": "The exact connected a-m-R silhouette in the user-supplied reference images is the visual authority. Preserve every contour, counter, join, proportion, terminal and the pointed cut of the lower R leg. Do not approximate from typed letters or redraw with CSS/SVG paths.",
    "approved_colour_and_finish_variants": {
      "dark_background_primary": "Metallic champagne / warm gold monogram.",
      "light_background_primary": "Deep emerald monogram with a restrained metallic edge.",
      "dark_background_flat": [
        "flat white",
        "flat champagne"
      ],
      "light_background_flat": [
        "flat black",
        "flat emerald"
      ],
      "large_brand_placements": [
        "silver-metal with champagne/copper edge",
        "metallic champagne"
      ],
      "compact_digital_placements": [
        "flat white",
        "flat black",
        "flat emerald",
        "flat champagne"
      ]
    },
    "asset_integrity": {
      "never_change_geometry": true,
      "allowed_changes": [
        "colour",
        "material_finish",
        "lighting",
        "background"
      ],
      "prohibited": [
        "redraw",
        "retype",
        "trace_approximation",
        "reshape",
        "crop_into_letterforms",
        "stretch",
        "skew",
        "perspective_distortion",
        "alter_negative_space",
        "separate_letters"
      ],
      "reference_raster_policy": "The supplied PNGs are authoritative visual references. Use them unchanged for reference and review. For production at arbitrary scale, request the original vector master; do not manufacture a replacement from the raster."
    },
    "production_asset_status": "approved transparent raster master and flat colour exports supplied; native editable vector master not supplied; SVG wrapper is raster-backed and must not be described as true vector.",
    "logo_display_rule": "standalone_monogram_only_no_frame_no_circle_no_shield_no_badge_no_background",
    "asset_package": {
      "master_raster": "brand/monogram/AMR_monogram_master_metallic.png",
      "flat_variants": {
        "white": "brand/monogram/AMR_monogram_white.png",
        "black": "brand/monogram/AMR_monogram_black.png",
        "emerald": "brand/monogram/AMR_monogram_emerald.png",
        "champagne": "brand/monogram/AMR_monogram_champagne.png"
      },
      "transparent_app_icons": [
        "brand/monogram/AMR_app_icon_192.png",
        "brand/monogram/AMR_app_icon_512.png",
        "brand/monogram/AMR_app_icon_1024.png"
      ],
      "svg_wrapper": "brand/monogram/AMR_monogram_master_raster-backed.svg",
      "svg_wrapper_is_native_vector": false,
      "native_vector_master_status": "not_supplied; do_not_trace_or_fabricate"
    },
    "monogram": {
      "vector_master": "brand/monogram/amr-monogram.svg",
      "raster_master": "brand/monogram/amr-white.png",
      "approved": "2026-11-16, owner",
      "note": "path vector traced from clean set B, overlap > 99%"
    }
